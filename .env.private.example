# Copy to .env.private.local (git-ignored). Used ONLY by the private build.
# These are public identifiers, not secrets. Never add a session secret/API token.
VITE_API_URL=https://REQUIRED_PRIVATE_WORKER.REQUIRED_WORKERS_SUBDOMAIN.workers.dev
VITE_GOOGLE_CLIENT_ID=REQUIRED_GOOGLE_WEB_CLIENT_ID
PRIVATE_PAGES_PROJECT=REQUIRED_PRIVATE_PAGES_PROJECT
# Exact stable origin, no slash/path. Must match private ALLOWED_ORIGIN and Google.
PRIVATE_FRONTEND_ORIGIN=https://REQUIRED_PRIVATE_FRONTEND.invalid
